---
import Base from "../layouts/Base.astro";
---

<Base title="Privacy — Quran Reader">
  <h1 class="text-3xl font-semibold tracking-tight">Privacy</h1>
  <div class="mt-6 flex flex-col gap-4 leading-relaxed">
    <p>Quran Reader has no accounts, no analytics and no tracking.</p>
    <p>
      Highlights, notes, bookmarks and reading position are stored in a local SQLite file on your device.
      They never leave it unless you export them yourself.
    </p>
    <p>
      The app only goes online to check GitHub Releases for updates and, if you choose to, to download
      optional translations.
    </p>
  </div>
</Base>
